{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicekit",
  "version": "0.1.0",
  "identifier": "io.longfreename.voicekit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1431",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voicekit",
        "width": 1240,
        "height": 860,
        "visible": false,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Voicekit: real-time voice changing, cloned voices, and speech output"
  }
}
